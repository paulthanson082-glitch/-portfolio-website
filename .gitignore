# Initialize git repository
git init

# Add all files
git add .

# Create first commit
git commit -m "Initial commit - Paul T Hanson portfolio"

# Set main branch (if needed)
git branch -M main

# Connect to GitHub (REPLACE WITH YOUR ACTUAL REPO URL)
git remote add origin https://github.com/paulthanson082-glitch/portfolio.git

# Push to GitHub
git push -u origin main
