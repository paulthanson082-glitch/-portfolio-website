{
  "metadata": {
    "name": "Portfolio Design System",
    "version": "1.0.0",
    "description": "Design tokens extracted from Paul T Hanson portfolio website"
  },
  "colors": {
    "primary": {
      "base": "#2563eb",
      "dark": "#1d4ed8",
      "light": "#3b82f6",
      "description": "Primary action color - used for buttons, links, and accents"
    },
    "text": {
      "primary": "#0f172a",
      "secondary": "#475569",
      "tertiary": "#334155",
      "subtle": "#64748b",
      "description": "Text colors for various hierarchy levels"
    },
    "background": {
      "page": "#f8fafc",
      "card": "#ffffff",
      "card_alt": "#f8fafc",
      "description": "Background colors for surfaces"
    },
    "border": {
      "light": "#e2e8f0",
      "medium": "#cbd5e1",
      "description": "Border colors for dividers and outlines"
    },
    "accent": {
      "lime": "#84cc16",
      "description": "Additional accent colors for emphasis"
    }
  },
  "typography": {
    "fontFamily": {
      "base": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fallback": "system-ui, sans-serif"
    },
    "fontFeatures": ["cv02", "cv04"],
    "scale": {
      "display_large": {
        "fontSize": "clamp(2rem, 4vw, 3.5rem)",
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-0.05em"
      },
      "display_medium": {
        "fontSize": "clamp(2rem, 5vw, 3.25rem)",
        "fontWeight": 700,
        "lineHeight": 1.05
      },
      "heading_xl": {
        "fontSize": "1.5rem",
        "fontWeight": 700
      },
      "heading_lg": {
        "fontSize": "1.1rem",
        "fontWeight": 700
      },
      "body": {
        "fontSize": "1rem",
        "lineHeight": 1.6
      },
      "body_sm": {
        "fontSize": "0.875rem"
      },
      "label": {
        "fontSize": "0.8rem",
        "fontWeight": 600,
        "textTransform": "uppercase",
        "letterSpacing": "0.28em"
      },
      "eyebrow": {
        "fontSize": "0.8rem",
        "fontWeight": 600,
        "textTransform": "uppercase",
        "letterSpacing": "0.24em"
      }
    }
  },
  "spacing": {
    "scale": {
      "xs": "0.5rem",
      "sm": "0.75rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "2.5rem"
    },
    "layout": {
      "maxWidth": "1100px",
      "gutter": "2rem",
      "gap": "1rem",
      "padding": "1.75rem"
    }
  },
  "borderRadius": {
    "sm": "1rem",
    "md": "1.25rem",
    "lg": "1.5rem",
    "full": "999px"
  },
  "shadows": {
    "section": {
      "value": "0 20px 40px rgba(15, 23, 42, 0.06)",
      "description": "Light shadow for cards and sections"
    },
    "hero": {
      "value": "0 30px 60px rgba(15, 23, 42, 0.08)",
      "description": "Elevated shadow for hero sections"
    }
  },
  "components": {
    "button": {
      "padding": "0.95rem 1.6rem",
      "borderRadius": "999px",
      "fontWeight": 700,
      "transition": "transform 0.2s ease, background 0.2s ease"
    },
    "card": {
      "padding": "1.75rem",
      "borderRadius": "1.25rem",
      "boxShadow": "0 20px 40px rgba(15, 23, 42, 0.06)"
    },
    "pill": {
      "padding": "0.9rem 1rem",
      "borderRadius": "999px",
      "fontWeight": 600,
      "border": "1px solid #cbd5e1"
    }
  }
}
